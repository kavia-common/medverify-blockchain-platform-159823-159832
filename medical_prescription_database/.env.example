# Example environment variables for medical_prescription_database
# Copy to .env and adjust as needed. Do NOT commit a filled .env with secrets.

# Path to the SQLite DB file. Use an absolute path if other containers must access the same file.
# Defaults to ./myapp.db if unset.
SQLITE_DB=https://vscode-internal-17431-beta.beta01.cloud.kavia.ai

# Port used by the lightweight health server (the orchestrator expects 5001 by default).
# If PORT is set, it takes precedence over HEALTH_PORT.
HEALTH_PORT=5001
