{"is_source_file": true, "format": "Python", "description": "This script is a database migration runner for a medical prescription database. It manages applying SQL migration files, tracking their application in a schema_migrations table, and providing commands to apply migrations, check migration status, and reset the database. The script is designed for SQLite, uses environment variables for configuration, and includes functions for checksum validation and migration application.", "external_files": ["migrations", "migrations", "os", "sys", "glob", "hashlib", "sqlite3", "datetime"], "external_methods": ["os.path.join", "os.getenv", "os.path.dirname", "os.path.exists", "os.remove", "glob.glob", "hashlib.sha256", "hashlib.sha256().update", "hashlib.sha256().hexdigest", "sqlite3.connect", "sqlite3.Connection.execute", "sqlite3.Connection.executescript", "sqlite3.Connection.close", "sys.argv", "sys.exit", "datetime.utcnow", "print"], "published": ["get_db_path", "migrate", "status", "reset"], "classes": [], "methods": [{"name": "str get_db_path()", "description": "Returns the SQLite database file path, using the SQLITE_DB environment variable or defaulting to 'myapp.db'.", "scope": "", "scopeKind": ""}, {"name": "sqlite3.Connection _connect(db_path: str)", "description": "Creates a SQLite connection to the specified database path and enables foreign key support.", "scope": "", "scopeKind": ""}, {"name": "None _ensure_migrations_table(conn: sqlite3.Connection)", "description": "Creates the schema_migrations table if it does not exist, used for tracking applied migrations.", "scope": "", "scopeKind": ""}, {"name": "str _file_checksum(path: str)", "description": "Calculates and returns the SHA256 checksum of a given file.", "scope": "", "scopeKind": ""}, {"name": "List[str] _list_migration_files()", "description": "Lists all migration SQL files in the migrations directory, sorted in ascending order.", "scope": "", "scopeKind": ""}, {"name": "List[Tuple[str,str]] _applied_